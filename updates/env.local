# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3100/api

# Public address RunPod and n8n can reach this app on.
# In development that is the ngrok tunnel. It changes on every ngrok restart.
NGROK_URL=https://4206-2001-16a4-60-c781-618e-202b-ee94-592a.ngrok-free.app
N8N_WEBHOOK_URL=https://n8n.axonagent.app/webhook/stc-chat

# --- Speech to text ---
STT_PROVIDER=openai
STT_SELF_HOSTED_URL=http://localhost:8000

# --- Text to speech: RunPod ---
# OmniVoice knows the "Najdi Arabic" language tag, so it is the default engine.
# Endpoint ids change whenever `flash undeploy` runs in the runpod-tts project.
RUNPOD_API_KEY=rpa_IS3NO6QMJDR96FBC1RAXN44SG6COBARTYHDFAYP1164k9h
OMNIVOICE_ENDPOINT_ID=tgbmh4mklvl2p8
VOXCPM_ENDPOINT_ID=hh4itugst7fv4t
# Which voice the app speaks with. Compare them all at /tts-lab.
TTS_VOICE_ID=alaa-omni

# --- Text to speech: the rewriter ---
# A small model fixes punctuation and inserts non-verbal tags before the voice
# reads the text. Numbers are handled in code, see src/lib/tts/arabicSpeech.ts.
# Clear OPENROUTER_API_KEY to turn the model off; the rules still run.
OPENROUTER_API_KEY=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
TTS_REWRITE_MODEL=openai/gpt-5.6-luna
TTS_REWRITE=1
# Set to 0 to see unredacted text while debugging. Never do that in a demo.
TTS_REDACT=1

# --- Mock settings ---
MOCK_OTP=123456
MOCK_DELAY_MS=500
# Set to 0 to skip loudness levelling. Needs ffmpeg on the PATH.
TTS_NORMALISE_LOUDNESS=0
