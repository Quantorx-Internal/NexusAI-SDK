{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "ai-assistant": [
        "../src/index"
      ],
      "ai-assistant/*": [
        "../src/*"
      ],
      "expo-audio": [
        "./node_modules/expo-audio"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
